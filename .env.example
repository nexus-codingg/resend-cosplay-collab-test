# Copy to .env.local and fill in. Never commit .env.local.

# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Sender on your verified domain
RESEND_FROM="Nexus Cosplays <hello@collab.nexuscosplays.com>"

# Domain with receiving enabled; reply-to addresses are collab+<token>@this-domain
RESEND_INBOUND_DOMAIN=collab.nexuscosplays.com

# Local SQLite file (no key needed)
DATABASE_URL=file:local.db

# Added in Phase 3 (receiving): webhook signing secret from the Resend dashboard
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx
